# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Generované mapy = kanonický výstup generátoru (regenerovatelné) → maps/<lokalita>/
# i maps/dataset_<terrain>/ (Sez. 39, kotveno v kořeni LAB přes MAPS_DIR). Jediné pravidlo
# nahradilo dřívější výčet per-lokalita (Soví vrch / Nová louka / Lidové sady / Hrubá Skála /
# Novina) + sandbox/** varianty — generátor povýšen ze sandbox/generator-poc na generator/.
maps/
# Scratch rendery (output_* chytá output_baseline/v2/…) + dočasné průzkumné výstupy
# (Sez. 24: WFS capabilities/schema, diagnostiky) → konvence „dočasné výstupy → temp/".
output/
output_*/
temp/
# ISOM-scan / scan-mining harness: verzovat bezpečný textový scaffold, ne copyright rastry/PDF ani běhy.
# Skeny, PDF, overlay/masky a syrové výstupy modelů zůstávají lokální (pravidlo B3).
isom_scan/*
!isom_scan/README.md
!isom_scan/task_isom_scan.md
!isom_scan/*.py
!isom_scan/*.html
!isom_scan/*.ps1
!isom_scan/calibration_manifest.json
!isom_scan/results.csv
!isom_scan/markers/
isom_scan/markers/*
!isom_scan/markers/*.json
!isom_scan/gt/
isom_scan/gt/*
!isom_scan/gt/ground_truth.json
!isom_scan/gt/task_crop_box.json
!isom_scan/runs/
isom_scan/runs/*
!isom_scan/runs/_run_template.json
isom_scan/**/*.png
isom_scan/**/*.pdf

# Velká binární data (mapy, rastry, LIDAR) — do gitu nepatří, odkaz v KB
*.tif
*.tiff
*.laz
*.las

# Cizí nástroje stažené lokálně (GPL binárky ~12 MB) — odkaz v tools-models.md
lasertool/

# Reálné mapy (páry picture+OMAP) — copyright třetích stran + velká binární data.
# Lokální hold-out / reference, NE do veřejného gitu. Metadata (původ, licence) v KB.
resources/*
# Výjimka: .pgw world-files = jen georef čísla (px velikost/rotace/levý-horní roh), žádný
# copyright mapový obsah → commitnout (audit A4 reprodukovatelnost — bez nich nejde měřit KPI
# na druhém stroji; resources/*.png/.omap zůstávají lokální).
!resources/*.pgw
# Výjimka: ruční crop polygon mapového pole (Sez. 173) = jen souřadnice rohů v px skenu, žádný
# copyright obsah → commitnout (neopakovatelná ruční práce, audit A6; bez něj separace/KPI padají
# na auto detekci, která propouští barevný layout = falešný les + kontaminace counts).
!resources/*_mapfield.json

# ISOM symbolový katalog: verzovat jen bezpečný kontrakt. Samotné SVG dumpy zůstávají
# lokální, dokud není vyjasněná licence/provenance.
!resources/isom/
resources/isom/*
!resources/isom/README.md
!resources/isom/index.schema.json

# Livelox korpus metadata (Sez. 71/76): ruční kurace + train/val/test split + ČR filtr = jen
# classId → tag/label JSON, žádný copyright mapový obsah → commitnout (audit A3/A4 —
# neopakovatelná ruční práce; bez nich mIoU napříč stroji neporovnatelné).
!resources/livelox/
resources/livelox/*
!resources/livelox/_curation.json
!resources/livelox/_split.json
!resources/livelox/_cz_filter.json

# Cache stažených reálných ČÚZK dat (nepatří do gitu, ale regenerovatelné → NEMAZAT, Sez. 25):
# DMR 5G dlaždice (výškopis), ZABAGED komunikace (GeoJSON z REST), ortofoto podklad. Kotveno
# u konektorů (connectors/.X_cache); pravidla bez leading-slash matchují v libovolném adresáři.
.dmr_cache/
.zabaged_cache/
.ortofoto_cache/
.ruian_cache/
.forest_cache/

# Claude / IDE lokální
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Codex = paralelní AI nástroj (Sez. 134); jeho lokální config do našeho repa nepatří (symetrie .claude).
.codex/
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store
